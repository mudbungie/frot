#!/usr/bin/env bash
# frot pre-commit: enforce 300-line cap on Rust source and 100% test coverage.
set -euo pipefail

fail=0

# 300-line cap on staged .rs files. Docs and config exempt.
while IFS= read -r f; do
  [ -f "$f" ] || continue
  lines=$(wc -l < "$f")
  if [ "$lines" -gt 300 ]; then
    echo "pre-commit: $f has $lines lines (limit 300)" >&2
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

if [ "$fail" -ne 0 ]; then
  exit 1
fi

# 100% line coverage. Only enforced when the commit touches .rs files —
# doc / config / hook changes shouldn't be gated on test coverage.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.rs$'; then
  if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found in PATH" >&2
    exit 1
  fi
  if ! cargo llvm-cov --version >/dev/null 2>&1; then
    echo "pre-commit: cargo-llvm-cov not installed. Run 'make setup'." >&2
    exit 1
  fi
  # Regions as well as lines: a fully-covered line can still hide an untaken
  # branch or an unreached `?` error edge, which is exactly where the blind
  # spots were. An unreachable region is a design signal — delete the dead path
  # or restructure it so it can be tested; never suppress it.
  cargo llvm-cov --fail-under-lines 100 --fail-under-regions 100 >/dev/null || {
    echo "pre-commit: line or region coverage below 100%" >&2
    exit 1
  }
fi
