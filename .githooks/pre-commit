#!/usr/bin/env bash
# frot pre-commit: enforce the source-file line cap and 100% test coverage.
set -euo pipefail

# Every gate below is a property of the *tree*, so every gate is keyed on the
# tracked source set and never on the index.
#
# `bl close` runs this hook on a worktree whose work is already committed: the
# index equals HEAD, so `git diff --cached` is EMPTY. An index-keyed gate
# therefore skipped on every close, and unformatted code, clippy warnings, a
# failing POSIX suite and coverage gaps all reached main and only reddened CI
# afterward (bl-0066). The line cap lost the same way and was moved off the
# index by bl-a68b; this is the rest of that move. The set is the same sweep CI
# runs, so the local close gate and CI cannot disagree about what passes.
#
# A tree with no Rust in it has nothing here to gate; everything below then
# applies vacuously, so say so once instead of four times.
tracked_rs="$(git ls-files '*.rs')"
[ -n "$tracked_rs" ] || exit 0

# Formatting. Cheap (well under a second), fails fast, and in lockstep with
# CI's `cargo fmt --check` (rust-toolchain.toml pins the formatter so both
# agree). `cargo fmt` reaches exactly the tracked .rs set, which is what
# tests/hygiene/fmt.rs asserts at `cargo test` speed.
cargo fmt --check || {
  echo "pre-commit: run 'cargo fmt' — tree is not formatted" >&2
  exit 1
}

# Line cap. The limit itself lives in scripts/line-limit.sh (one home, shared
# with CI); both callers feed it the same sweep.
printf '%s\n' "$tracked_rs" | scripts/line-limit.sh || exit 1

# Clippy. Runs before coverage so a lint error fails faster than the
# instrumented build. Calls the Makefile `lint` target (one home, shared with
# CI's `make lint`).
make lint || {
  echo "pre-commit: clippy reported warnings (make lint)" >&2
  exit 1
}

# POSIX conformance (docs/design/posix.md, gated by scripts/posix-suite.sh via
# `make posix`). Keeps the local close gate in lockstep with CI's "POSIX
# conformance suite" step.
make posix || {
  echo "pre-commit: POSIX conformance suite failed (make posix)" >&2
  exit 1
}

# 100% line + region coverage. The threshold lives in the Makefile `cov` target
# (one home, shared with CI); regions as well as lines, because a fully-covered
# line can still hide an untaken branch or an unreached `?` edge — an
# unreachable region is a design signal to delete the dead path, never to
# suppress.
if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found in PATH" >&2
  exit 1
fi
if ! cargo llvm-cov --version >/dev/null 2>&1; then
  echo "pre-commit: cargo-llvm-cov not installed. Run 'make setup'." >&2
  exit 1
fi
make cov >/dev/null || {
  echo "pre-commit: line or region coverage below 100%" >&2
  exit 1
}
