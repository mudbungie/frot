#!/usr/bin/env bash
# frot pre-commit: enforce the source-file line cap and 100% test coverage.
set -euo pipefail

# Staged .rs files, once. Docs and config are exempt from both gates.
staged_rs="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)"

# Formatting. Cheap, fails fast, and keeps the local close gate in lockstep with
# CI's `cargo fmt --check` (rust-toolchain.toml pins the formatter so both agree).
# Without this here, unformatted code lands through `bl close` and only reddens
# CI afterward.
if [ -n "$staged_rs" ]; then
  cargo fmt --check || {
    echo "pre-commit: run 'cargo fmt' — tree is not formatted" >&2
    exit 1
  }
fi

# Line cap. The limit itself lives in scripts/line-limit.sh (one home, shared
# with CI); the hook only feeds it the staged set.
if [ -n "$staged_rs" ]; then
  printf '%s\n' "$staged_rs" | scripts/line-limit.sh || exit 1
fi

# Clippy. Runs before coverage so a lint error fails faster than the
# instrumented build. Calls the Makefile `lint` target (one home, shared with
# CI's `make lint`); without it here, a warning passes `bl close` and only
# reddens CI afterward.
if [ -n "$staged_rs" ]; then
  make lint || {
    echo "pre-commit: clippy reported warnings (make lint)" >&2
    exit 1
  }
fi

# 100% line + region coverage. Only when the commit touches .rs files —
# doc / config / hook changes shouldn't be gated on test coverage. The
# threshold lives in the Makefile `cov` target (one home, shared with CI);
# regions as well as lines, because a fully-covered line can still hide an
# untaken branch or an unreached `?` edge — an unreachable region is a design
# signal to delete the dead path, never to suppress.
if [ -n "$staged_rs" ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found in PATH" >&2
    exit 1
  fi
  if ! cargo llvm-cov --version >/dev/null 2>&1; then
    echo "pre-commit: cargo-llvm-cov not installed. Run 'make setup'." >&2
    exit 1
  fi
  make cov >/dev/null || {
    echo "pre-commit: line or region coverage below 100%" >&2
    exit 1
  }
fi
